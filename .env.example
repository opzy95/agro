VITE_API_BASE_URL=http://localhost:3000/api
# Optional. Set this only if your Express server exposes a health endpoint.
VITE_API_HEALTH_PATH=/health

# Server-only Paystack secret. Never use this in a VITE_ variable.
PAYSTACK_SECRET_KEY=sk_test_your_secret_key
CLIENT_URL=http://localhost:5173
PORT=3000